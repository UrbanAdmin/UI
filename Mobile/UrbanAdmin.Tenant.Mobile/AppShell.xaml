<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="UrbanAdmin.Tenant.Mobile.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:auth="clr-namespace:UrbanAdmin.Tenant.Mobile.Auth"
    xmlns:notificaciones="clr-namespace:UrbanAdmin.Tenant.Mobile.Notificaciones"
    xmlns:pagos="clr-namespace:UrbanAdmin.Tenant.Mobile.Pagos"
    xmlns:admin="clr-namespace:UrbanAdmin.Tenant.Mobile.Admin"
    xmlns:account="clr-namespace:UrbanAdmin.Tenant.Mobile.Account"
    FlyoutBehavior="Disabled"
    Title="UrbanAdmin">

    <ShellContent
        Title="Ingresar"
        Route="Login"
        ContentTemplate="{DataTemplate auth:LoginPage}" />

    <!-- Tenant (ApartmentOwner) tabs; visibility toggled per-role after login in AppShell.xaml.cs
         (specs/008-mobile-admin-views/research.md §6 - single TabBar, not a flyout redesign). -->
    <TabBar>
        <ShellContent
            x:Name="NotificacionesTab"
            Title="Notificaciones"
            Icon="icon_bell.svg"
            Route="Notificaciones"
            ContentTemplate="{DataTemplate notificaciones:NotificacionesPage}" />
        <ShellContent
            x:Name="PagosTab"
            Title="Pagos"
            Icon="icon_card.svg"
            Route="Pagos"
            ContentTemplate="{DataTemplate pagos:PagosPage}" />
        <ShellContent
            x:Name="ApartmentsTab"
            Title="Apartamentos"
            Icon="icon_building.svg"
            Route="Apartments"
            ContentTemplate="{DataTemplate admin:ApartmentsPage}" />
        <ShellContent
            x:Name="UsersTab"
            Title="Usuarios"
            Icon="icon_people.svg"
            Route="Users"
            ContentTemplate="{DataTemplate admin:UsersPage}" />
        <ShellContent
            x:Name="AdminPagosTab"
            Title="Pagos (Admin)"
            Icon="icon_card.svg"
            Route="AdminPagos"
            ContentTemplate="{DataTemplate admin:AdminPagosPage}" />
        <ShellContent
            x:Name="AdminNotificacionesTab"
            Title="Notificaciones (Admin)"
            Icon="icon_bell.svg"
            Route="AdminNotificaciones"
            ContentTemplate="{DataTemplate admin:AdminNotificacionesPage}" />
        <!-- 010-logout-biometric-login: the app's first tab shared by both roles - visibility
             set unconditionally in AppShell.xaml.cs's ApplyRoleVisibility, unlike every tab above. -->
        <ShellContent
            x:Name="AccountTab"
            Title="Cuenta"
            Icon="icon_account.svg"
            Route="Account"
            ContentTemplate="{DataTemplate account:AccountPage}" />
    </TabBar>

</Shell>
