<?xml version="1.0" encoding="utf-8" ?>
<!--
  017-icon-only-tab-bar: one alert card, shared by Alertas and "Todas las alertas" so the look cannot diverge
  (mockup Mockups/tab-bar-icon-only). An unread card is raised (soft shadow, lighter tone in dark), has a dot
  and a bolder title, and swipes sideways to reveal the green "Leída" action (a full swipe invokes it); a read
  card is flat and does not swipe. The page reacts to MarkReadRequested. Announcements keep the sage ground.
-->
<ContentView
    x:Class="UrbanAdmin.Tenant.Mobile.Controls.AlertCardView"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:controls="clr-namespace:UrbanAdmin.Tenant.Mobile.Controls">

    <SwipeView IsEnabled="{Binding IsUnread}">
        <SwipeView.LeftItems>
            <SwipeItems Mode="Execute" SwipeBehaviorOnInvoked="Close">
                <SwipeItem
                    Text="Leída"
                    BackgroundColor="{AppThemeBinding Light={StaticResource Success}, Dark={StaticResource SuccessDark}}"
                    Invoked="OnInvoked" />
            </SwipeItems>
        </SwipeView.LeftItems>
        <SwipeView.RightItems>
            <SwipeItems Mode="Execute" SwipeBehaviorOnInvoked="Close">
                <SwipeItem
                    Text="Leída"
                    BackgroundColor="{AppThemeBinding Light={StaticResource Success}, Dark={StaticResource SuccessDark}}"
                    Invoked="OnInvoked" />
            </SwipeItems>
        </SwipeView.RightItems>

        <!-- The margin leaves room for the soft shadow of an unread card (a view clips its own shadow). -->
        <Border
            Style="{StaticResource CardBorder}"
            Margin="6,2,6,16"
            Padding="18,16,18,15"
            StrokeShape="RoundRectangle 26">
            <Border.Triggers>
                <DataTrigger TargetType="Border" Binding="{Binding IsUnread}" Value="True">
                    <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource CardRaised}, Dark={StaticResource CardRaisedDark}}" />
                    <Setter Property="Shadow">
                        <Setter.Value>
                            <Shadow Brush="{StaticResource Black}" Offset="0,6" Radius="14" Opacity="0.28" />
                        </Setter.Value>
                    </Setter>
                </DataTrigger>
                <DataTrigger TargetType="Border" Binding="{Binding Kind}" Value="announcement">
                    <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource SuccessBg}, Dark={StaticResource SuccessBgDark}}" />
                </DataTrigger>
            </Border.Triggers>
            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                <controls:StatusDot Grid.Column="0" Kind="{Binding Kind}" Size="12" Margin="0,6,0,0" />
                <VerticalStackLayout Grid.Column="1" Spacing="3">
                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
                        <Border
                            Grid.Column="0"
                            WidthRequest="10"
                            HeightRequest="10"
                            VerticalOptions="Center"
                            Stroke="Transparent"
                            StrokeShape="RoundRectangle 5"
                            IsVisible="{Binding IsUnread}"
                            BackgroundColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}" />
                        <Label
                            Grid.Column="1"
                            Text="{Binding Title}"
                            FontFamily="FigtreeSemibold"
                            FontSize="17">
                            <Label.Triggers>
                                <DataTrigger TargetType="Label" Binding="{Binding IsUnread}" Value="True">
                                    <Setter Property="FontAttributes" Value="Bold" />
                                </DataTrigger>
                            </Label.Triggers>
                        </Label>
                        <Label
                            Grid.Column="2"
                            Text="{Binding When}"
                            Style="{StaticResource Muted}"
                            FontSize="13"
                            VerticalOptions="Start" />
                    </Grid>
                    <Label Text="{Binding Text}" FontSize="15" />
                    <controls:StatusChip Kind="{Binding Kind}" Text="{Binding Chip}" Margin="0,6,0,0" />
                </VerticalStackLayout>
            </Grid>
        </Border>
    </SwipeView>
</ContentView>
