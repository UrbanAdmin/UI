<?xml version="1.0" encoding="UTF-8" ?>
<ResourceDictionary 
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <!-- Note: For Android please see also Platforms\Android\Resources\values\colors.xml -->

    <Color x:Key="Primary">#1E3A5F</Color>
    <Color x:Key="PrimaryDark">#7FA6D1</Color>
    <Color x:Key="PrimaryDarkText">#242424</Color>
    <Color x:Key="Secondary">#E8EEF5</Color>
    <Color x:Key="SecondaryDarkText">#7FA6D1</Color>
    <Color x:Key="Tertiary">#14283F</Color>

    <Color x:Key="White">White</Color>
    <Color x:Key="Black">Black</Color>
    <Color x:Key="Magenta">#D600AA</Color>
    <Color x:Key="MidnightBlue">#190649</Color>
    <Color x:Key="OffBlack">#1f1f1f</Color>

    <Color x:Key="Gray100">#E1E1E1</Color>
    <Color x:Key="Gray200">#C8C8C8</Color>
    <Color x:Key="Gray300">#ACACAC</Color>
    <Color x:Key="Gray400">#919191</Color>
    <Color x:Key="Gray500">#6E6E6E</Color>
    <Color x:Key="Gray600">#404040</Color>
    <Color x:Key="Gray900">#212121</Color>
    <Color x:Key="Gray950">#141414</Color>

    <!-- Payment status chip colors - mirrors Mockups/admin-payments-summary-and-edit/index.html -->
    <Color x:Key="Success">#1E8E5A</Color>
    <Color x:Key="SuccessDark">#4ADE94</Color>
    <Color x:Key="SuccessBg">#E4F5EC</Color>
    <Color x:Key="SuccessBgDark">#163325</Color>

    <Color x:Key="Pending">#A9700A</Color>
    <Color x:Key="PendingDark">#E3B15C</Color>
    <Color x:Key="PendingBg">#FBF0DD</Color>
    <Color x:Key="PendingBgDark">#33270F</Color>

    <Color x:Key="PlaceholderText">#6B5B95</Color>
    <Color x:Key="PlaceholderTextDark">#B7A8E0</Color>
    <Color x:Key="PlaceholderBg">#F5F1FA</Color>
    <Color x:Key="PlaceholderBgDark">#241F35</Color>

    <!-- Notification status chip colors (due-today/overdue/not-due) - mirrors
         status-chip.component.css's canonical status→color mapping, adapted to this app's
         soft-background chip convention. -->
    <Color x:Key="Urgent">#C15A00</Color>
    <Color x:Key="UrgentDark">#F0A857</Color>
    <Color x:Key="UrgentBg">#FCEADA</Color>
    <Color x:Key="UrgentBgDark">#3A2711</Color>

    <Color x:Key="Danger">#C62828</Color>
    <Color x:Key="DangerDark">#F28B8B</Color>
    <Color x:Key="DangerBg">#FBE6E6</Color>
    <Color x:Key="DangerBgDark">#3A1616</Color>

    <Color x:Key="Neutral">#5B6B82</Color>
    <Color x:Key="NeutralDark">#93A2B5</Color>
    <Color x:Key="NeutralBg">#EEF1F5</Color>
    <Color x:Key="NeutralBgDark">#22334A</Color>

    <SolidColorBrush x:Key="PrimaryBrush" Color="{StaticResource Primary}"/>
    <SolidColorBrush x:Key="SecondaryBrush" Color="{StaticResource Secondary}"/>
    <SolidColorBrush x:Key="TertiaryBrush" Color="{StaticResource Tertiary}"/>
    <SolidColorBrush x:Key="WhiteBrush" Color="{StaticResource White}"/>
    <SolidColorBrush x:Key="BlackBrush" Color="{StaticResource Black}"/>

    <SolidColorBrush x:Key="Gray100Brush" Color="{StaticResource Gray100}"/>
    <SolidColorBrush x:Key="Gray200Brush" Color="{StaticResource Gray200}"/>
    <SolidColorBrush x:Key="Gray300Brush" Color="{StaticResource Gray300}"/>
    <SolidColorBrush x:Key="Gray400Brush" Color="{StaticResource Gray400}"/>
    <SolidColorBrush x:Key="Gray500Brush" Color="{StaticResource Gray500}"/>
    <SolidColorBrush x:Key="Gray600Brush" Color="{StaticResource Gray600}"/>
    <SolidColorBrush x:Key="Gray900Brush" Color="{StaticResource Gray900}"/>
    <SolidColorBrush x:Key="Gray950Brush" Color="{StaticResource Gray950}"/>
</ResourceDictionary>