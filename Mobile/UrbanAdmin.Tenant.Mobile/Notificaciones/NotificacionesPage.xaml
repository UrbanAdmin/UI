<?xml version="1.0" encoding="utf-8" ?>
<!--
  013-tenant-pagos-alertas-redesign: the tenant "Alertas" screen, built to the approved mockup
  (Mockups/tenant-alertas-cards/index.html). 017-icon-only-tab-bar (Mockups/tab-bar-icon-only): it lists only the
  alerts the tenant has not read; a card is marked read by swiping it (green "Leída") and then disappears, the header
  action "Marcar todas" clears the list, and the link "Ver todas las notificaciones" opens the full list. The route
  and class name stay "Notificaciones" so navigation code is untouched.
-->
<ContentPage
    x:Class="UrbanAdmin.Tenant.Mobile.Notificaciones.NotificacionesPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:controls="clr-namespace:UrbanAdmin.Tenant.Mobile.Controls"
    xmlns:rows="clr-namespace:UrbanAdmin.Tenant.Mobile.Core.ViewModels;assembly=UrbanAdmin.Tenant.Mobile.Core"
    Shell.NavBarIsVisible="False"
    Title="Alertas">

    <ScrollView>
        <VerticalStackLayout Padding="16,0,16,28" Spacing="0">
            <controls:TenantHeader x:Name="Header" Kicker="Tus avisos" Title="Alertas" ActionClicked="OnMarkAllClicked" />

            <ActivityIndicator x:Name="BusyIndicator" IsRunning="False" IsVisible="False" Margin="0,60,0,0" />

            <VerticalStackLayout x:Name="ErrorPanel" IsVisible="False" Spacing="12" Margin="6,4,6,0">
                <Border
                    Padding="18,16"
                    Stroke="Transparent"
                    StrokeShape="RoundRectangle 22"
                    BackgroundColor="{AppThemeBinding Light={StaticResource PendingBg}, Dark={StaticResource PendingBgDark}}">
                    <Label
                        x:Name="ErrorLabel"
                        FontAttributes="Bold"
                        TextColor="{AppThemeBinding Light={StaticResource Pending}, Dark={StaticResource PendingDark}}" />
                </Border>
                <Button Text="Reintentar" HorizontalOptions="Center" Clicked="OnRetryClicked" />
            </VerticalStackLayout>

            <Border
                x:Name="EmptyPanel"
                IsVisible="False"
                Margin="6,0"
                Padding="18,26"
                Stroke="{AppThemeBinding Light={StaticResource Gray300}, Dark={StaticResource Gray600}}"
                StrokeDashArray="4,4"
                StrokeShape="RoundRectangle 22">
                <VerticalStackLayout Spacing="6">
                    <Label
                        Text="Todo en orden"
                        Style="{StaticResource SubHeadline}"
                        HorizontalTextAlignment="Center" />
                    <Label
                        Text="No tienes alertas sin leer. Aquí verás los recordatorios de pago, los pagos confirmados y los comunicados nuevos."
                        Style="{StaticResource Muted}"
                        HorizontalTextAlignment="Center" />
                </VerticalStackLayout>
            </Border>

            <Label
                x:Name="SwipeHint"
                Text="Desliza una tarjeta hacia un lado para marcarla como leída."
                Style="{StaticResource Muted}"
                FontSize="13"
                Margin="6,0,6,10"
                IsVisible="False" />

            <!-- One card per unread alert; marking one read removes it from this list. -->
            <VerticalStackLayout x:Name="CardsList" Spacing="0" IsVisible="False">
                <BindableLayout.ItemTemplate>
                    <DataTemplate x:DataType="rows:AlertCardRow">
                        <controls:AlertCardView MarkReadRequested="OnMarkReadRequested" />
                    </DataTemplate>
                </BindableLayout.ItemTemplate>
            </VerticalStackLayout>

            <Button
                x:Name="SeeAllButton"
                Text="Ver todas las notificaciones"
                Style="{StaticResource ButtonSecondary}"
                Margin="6,4,6,0"
                IsVisible="False"
                Clicked="OnSeeAllClicked" />
        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
