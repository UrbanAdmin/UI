<?xml version="1.0" encoding="utf-8" ?>
<!--
  013-tenant-pagos-alertas-redesign: the tenant "Alertas" screen, built to the approved mockup
  (Mockups/tenant-alertas-cards/index.html): the shared header ("TUS AVISOS" / "Alertas" + logout) and
  one rounded card per alert (colored dot, title, relative date, text, status chip). The route and
  class name stay "Notificaciones" so navigation code is untouched; only the tab title changed.
-->
<ContentPage
    x:Class="UrbanAdmin.Tenant.Mobile.Notificaciones.NotificacionesPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:controls="clr-namespace:UrbanAdmin.Tenant.Mobile.Controls"
    xmlns:rows="clr-namespace:UrbanAdmin.Tenant.Mobile.Core.ViewModels;assembly=UrbanAdmin.Tenant.Mobile.Core"
    Shell.NavBarIsVisible="False"
    Title="Alertas">

    <ScrollView>
        <VerticalStackLayout Padding="22,0,22,28" Spacing="0">
            <controls:TenantHeader Kicker="Tus avisos" Title="Alertas" />

            <ActivityIndicator x:Name="BusyIndicator" IsRunning="False" IsVisible="False" Margin="0,60,0,0" />

            <VerticalStackLayout x:Name="ErrorPanel" IsVisible="False" Spacing="12" Margin="0,4,0,0">
                <Border
                    Padding="18,16"
                    Stroke="Transparent"
                    StrokeShape="RoundRectangle 22"
                    BackgroundColor="{AppThemeBinding Light={StaticResource PendingBg}, Dark={StaticResource PendingBgDark}}">
                    <Label
                        x:Name="ErrorLabel"
                        FontAttributes="Bold"
                        TextColor="{AppThemeBinding Light={StaticResource Pending}, Dark={StaticResource PendingDark}}" />
                </Border>
                <Button Text="Reintentar" HorizontalOptions="Center" Clicked="OnRetryClicked" />
            </VerticalStackLayout>

            <Border
                x:Name="EmptyPanel"
                IsVisible="False"
                Padding="18,26"
                Stroke="{AppThemeBinding Light={StaticResource Gray300}, Dark={StaticResource Gray600}}"
                StrokeDashArray="4,4"
                StrokeShape="RoundRectangle 22">
                <VerticalStackLayout Spacing="6">
                    <Label
                        Text="Todo en orden"
                        Style="{StaticResource SubHeadline}"
                        HorizontalTextAlignment="Center" />
                    <Label
                        Text="No tienes avisos por ahora. Aquí verás recordatorios de pago, pagos confirmados y comunicados."
                        Style="{StaticResource Muted}"
                        HorizontalTextAlignment="Center" />
                </VerticalStackLayout>
            </Border>

            <!-- One card per alert. Announcements ("Comunicado") sit on a light sage ground. -->
            <VerticalStackLayout x:Name="CardsList" Spacing="12" IsVisible="False">
                <BindableLayout.ItemTemplate>
                    <DataTemplate x:DataType="rows:AlertCardRow">
                        <Border
                            Style="{StaticResource CardBorder}"
                            Padding="18,16,18,15"
                            StrokeShape="RoundRectangle 26"
                            AutomationProperties.Name="{Binding AccessibleName}">
                            <Border.Triggers>
                                <DataTrigger TargetType="Border" Binding="{Binding Kind}" Value="announcement">
                                    <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource SuccessBg}, Dark={StaticResource SuccessBgDark}}" />
                                </DataTrigger>
                            </Border.Triggers>
                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                                <controls:StatusDot Grid.Column="0" Kind="{Binding Kind}" Size="12" Margin="0,6,0,0" />
                                <VerticalStackLayout Grid.Column="1" Spacing="3">
                                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
                                        <!-- 017: a small accent dot on a card that was unread when this screen opened (that visit only). -->
                                        <Border
                                            Grid.Column="0"
                                            WidthRequest="10"
                                            HeightRequest="10"
                                            VerticalOptions="Center"
                                            Stroke="Transparent"
                                            StrokeShape="RoundRectangle 5"
                                            IsVisible="{Binding IsNew}"
                                            BackgroundColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}" />
                                        <Label
                                            Grid.Column="1"
                                            Text="{Binding Title}"
                                            FontFamily="FigtreeSemibold"
                                            FontSize="17" />
                                        <Label
                                            Grid.Column="2"
                                            Text="{Binding When}"
                                            Style="{StaticResource Muted}"
                                            FontSize="13"
                                            VerticalOptions="Start" />
                                    </Grid>
                                    <Label Text="{Binding Text}" FontSize="15" />
                                    <controls:StatusChip Kind="{Binding Kind}" Text="{Binding Chip}" Margin="0,6,0,0" />
                                </VerticalStackLayout>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </BindableLayout.ItemTemplate>
            </VerticalStackLayout>
        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
