<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="UrbanAdmin.Tenant.Mobile.Notificaciones.NotificacionesPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:models="clr-namespace:UrbanAdmin.Tenant.Mobile.Core.Models;assembly=UrbanAdmin.Tenant.Mobile.Core"
    Title="Notificaciones">

    <Grid RowDefinitions="*" Padding="16">
        <ActivityIndicator x:Name="BusyIndicator" IsRunning="False" IsVisible="False" VerticalOptions="Center" />

        <Label
            x:Name="EmptyLabel"
            Text="No tienes notificaciones por ahora."
            IsVisible="False"
            HorizontalOptions="Center"
            VerticalOptions="Center" />

        <Label
            x:Name="ErrorLabel"
            Text="No se pudieron cargar las notificaciones."
            TextColor="Red"
            IsVisible="False"
            HorizontalOptions="Center"
            VerticalOptions="Center" />

        <CollectionView x:Name="ItemsList" IsVisible="False">
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="models:NotificacionModel">
                    <VerticalStackLayout Padding="0,8" Spacing="2">
                        <Label Text="{Binding Utility}" FontAttributes="Bold" />
                        <Label Text="{Binding Amount, StringFormat='Monto: {0}'}" />
                        <Label Text="{Binding DueDate, StringFormat='Vence: {0:dd/MM/yyyy}'}" />
                        <Label Text="{Binding Status}" />
                    </VerticalStackLayout>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </Grid>

</ContentPage>
