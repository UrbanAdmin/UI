<?xml version="1.0" encoding="utf-8" ?>
<!--
  Restyled to the Organic look shared with the redesigned tenant screens (013-tenant-pagos-alertas-redesign):
  the shared header (with a back arrow) replaces the native title bar, fields sit in the theme's pill
  shells and the error text uses the theme color. Same fields, same buttons, same behaviour.
-->
<ContentPage
    x:Class="UrbanAdmin.Tenant.Mobile.Admin.UserEditPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:controls="clr-namespace:UrbanAdmin.Tenant.Mobile.Controls"
    Shell.NavBarIsVisible="False"
    Title="Usuario">

    <ScrollView>
        <VerticalStackLayout Padding="22,0,22,28" Spacing="14">
            <controls:TenantHeader Kicker="Cuentas y roles" Title="Usuario" ShowLogout="False" ShowBack="True" />

            <Border Style="{StaticResource FieldBorder}" StrokeShape="RoundRectangle 999" Padding="20,2">
                <Entry x:Name="UsernameEntry" Placeholder="Usuario" />
            </Border>

            <Border Style="{StaticResource FieldBorder}" StrokeShape="RoundRectangle 999" Padding="20,2">
                <Entry x:Name="PasswordEntry" Placeholder="Contraseña" IsPassword="True" />
            </Border>
            <Label
                x:Name="PasswordHintLabel"
                Text="Dejar en blanco para no cambiarla"
                Style="{StaticResource Muted}"
                FontSize="13"
                IsVisible="False" />

            <Border Style="{StaticResource FieldBorder}" StrokeShape="RoundRectangle 999" Padding="20,2">
                <Picker x:Name="RolePicker" Title="Rol" SelectedIndexChanged="OnRoleChanged">
                    <Picker.ItemsSource>
                        <x:Array Type="{x:Type x:String}">
                            <x:String>Administrador</x:String>
                            <x:String>Arrendatario</x:String>
                        </x:Array>
                    </Picker.ItemsSource>
                </Picker>
            </Border>

            <Border x:Name="ApartmentPickerShell" Style="{StaticResource FieldBorder}" StrokeShape="RoundRectangle 999" Padding="20,2" IsVisible="{Binding Source={x:Reference ApartmentPicker}, Path=IsVisible}">
                <Picker x:Name="ApartmentPicker" Title="Apartamento" IsVisible="False" />
            </Border>

            <Label
                x:Name="ErrorLabel"
                FontAttributes="Bold"
                IsVisible="False"
                TextColor="{AppThemeBinding Light={StaticResource Pending}, Dark={StaticResource PendingDark}}" />

            <Button x:Name="SaveButton" Text="Guardar" MinimumHeightRequest="52" Clicked="OnSaveClicked" />
            <Button
                x:Name="DeleteButton"
                Text="Eliminar"
                Style="{StaticResource ButtonSecondary}"
                TextColor="{AppThemeBinding Light={StaticResource Pending}, Dark={StaticResource PendingDark}}"
                Clicked="OnDeleteClicked"
                IsVisible="False" />

            <ActivityIndicator x:Name="BusyIndicator" IsRunning="False" IsVisible="False" />
        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
