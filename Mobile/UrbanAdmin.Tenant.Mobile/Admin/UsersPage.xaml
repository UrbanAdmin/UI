<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="UrbanAdmin.Tenant.Mobile.Admin.UsersPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:admin="clr-namespace:UrbanAdmin.Tenant.Mobile.Admin"
    Title="Usuarios">

    <ContentPage.ToolbarItems>
        <ToolbarItem Text="Agregar" Clicked="OnAddClicked" />
    </ContentPage.ToolbarItems>

    <Grid RowDefinitions="*" Padding="16">
        <ActivityIndicator x:Name="BusyIndicator" IsRunning="False" IsVisible="False" VerticalOptions="Center" />

        <Label
            x:Name="EmptyLabel"
            Text="No hay usuarios registrados."
            IsVisible="False"
            HorizontalOptions="Center"
            VerticalOptions="Center" />

        <Label
            x:Name="ErrorLabel"
            Text="No se pudieron cargar los usuarios."
            TextColor="Red"
            IsVisible="False"
            HorizontalOptions="Center"
            VerticalOptions="Center" />

        <CollectionView x:Name="ItemsList" IsVisible="False" SelectionMode="Single" SelectionChanged="OnUserSelected">
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="admin:UserListRow">
                    <VerticalStackLayout>
                        <Grid Padding="4,10" ColumnDefinitions="*,Auto" ColumnSpacing="10">
                            <VerticalStackLayout Grid.Column="0" Spacing="1">
                                <Label Text="{Binding Username}" FontAttributes="Bold" FontSize="13.5" />
                                <Label
                                    Text="{Binding ApartmentLabel, StringFormat='Apartamento: {0}'}"
                                    FontSize="12"
                                    TextColor="{AppThemeBinding Light={StaticResource Gray500}, Dark={StaticResource Gray300}}" />
                            </VerticalStackLayout>
                            <Border
                                Grid.Column="1"
                                VerticalOptions="Center"
                                Padding="9,3"
                                Stroke="Transparent"
                                StrokeShape="RoundRectangle 999">
                                <Border.Triggers>
                                    <DataTrigger TargetType="Border" Binding="{Binding RoleLabel}" Value="Administrador">
                                        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource Secondary}, Dark={StaticResource Gray900}}" />
                                    </DataTrigger>
                                    <DataTrigger TargetType="Border" Binding="{Binding RoleLabel}" Value="Arrendatario">
                                        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource PlaceholderBg}, Dark={StaticResource PlaceholderBgDark}}" />
                                    </DataTrigger>
                                </Border.Triggers>
                                <Label Text="{Binding RoleLabel}" FontSize="11" FontAttributes="Bold">
                                    <Label.Triggers>
                                        <DataTrigger TargetType="Label" Binding="{Binding RoleLabel}" Value="Administrador">
                                            <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource Tertiary}, Dark={StaticResource PrimaryDark}}" />
                                        </DataTrigger>
                                        <DataTrigger TargetType="Label" Binding="{Binding RoleLabel}" Value="Arrendatario">
                                            <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource PlaceholderText}, Dark={StaticResource PlaceholderTextDark}}" />
                                        </DataTrigger>
                                    </Label.Triggers>
                                </Label>
                            </Border>
                        </Grid>
                        <BoxView HeightRequest="1" Color="{AppThemeBinding Light={StaticResource Gray100}, Dark={StaticResource Gray900}}" />
                    </VerticalStackLayout>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </Grid>

</ContentPage>
