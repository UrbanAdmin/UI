<?xml version="1.0" encoding="utf-8" ?>
<!--
  Restyled to the Organic look shared with the redesigned tenant screens (013-tenant-pagos-alertas-redesign):
  the shared header replaces the native title bar ("Agregar" moved from the toolbar into the header) and
  each user is a rounded card. Same data, same interactions.
-->
<ContentPage
    x:Class="UrbanAdmin.Tenant.Mobile.Admin.UsersPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:controls="clr-namespace:UrbanAdmin.Tenant.Mobile.Controls"
    xmlns:admin="clr-namespace:UrbanAdmin.Tenant.Mobile.Admin"
    Shell.NavBarIsVisible="False"
    Title="Usuarios">

    <Grid RowDefinitions="Auto,*">
        <controls:TenantHeader
            Grid.Row="0"
            Margin="22,0"
            Kicker="Cuentas y roles"
            Title="Usuarios"
            ShowLogout="False"
            ActionText="Agregar"
            ActionClicked="OnAddClicked" />

        <Grid Grid.Row="1" Padding="22,0,22,0">
            <ActivityIndicator x:Name="BusyIndicator" IsRunning="False" IsVisible="False" VerticalOptions="Center" />

            <Label
                x:Name="EmptyLabel"
                Text="No hay usuarios registrados."
                Style="{StaticResource Muted}"
                IsVisible="False"
                HorizontalOptions="Center"
                VerticalOptions="Center" />

            <Label
                x:Name="ErrorLabel"
                Text="No se pudieron cargar los usuarios."
                FontAttributes="Bold"
                TextColor="{AppThemeBinding Light={StaticResource Pending}, Dark={StaticResource PendingDark}}"
                IsVisible="False"
                HorizontalOptions="Center"
                VerticalOptions="Center" />

            <CollectionView x:Name="ItemsList" IsVisible="False" SelectionMode="Single" SelectionChanged="OnUserSelected">
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="admin:UserListRow">
                        <Border Style="{StaticResource CardBorder}" Margin="0,0,0,10" Padding="16,14" StrokeShape="RoundRectangle 22">
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                                <VerticalStackLayout Grid.Column="0" Spacing="2">
                                    <Label Text="{Binding Username}" FontFamily="FigtreeSemibold" FontSize="17" />
                                    <Label
                                        Text="{Binding ApartmentLabel, StringFormat='Apartamento: {0}'}"
                                        Style="{StaticResource Muted}"
                                        FontSize="13" />
                                </VerticalStackLayout>
                                <Border
                                    Grid.Column="1"
                                    VerticalOptions="Center"
                                    Padding="12,4"
                                    Stroke="Transparent"
                                    StrokeShape="RoundRectangle 999"
                                    BackgroundColor="{AppThemeBinding Light={StaticResource NeutralBg}, Dark={StaticResource NeutralBgDark}}">
                                    <Border.Triggers>
                                        <DataTrigger TargetType="Border" Binding="{Binding RoleLabel}" Value="Administrador">
                                            <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource PendingBg}, Dark={StaticResource PendingBgDark}}" />
                                        </DataTrigger>
                                        <DataTrigger TargetType="Border" Binding="{Binding RoleLabel}" Value="Arrendatario">
                                            <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource SuccessBg}, Dark={StaticResource SuccessBgDark}}" />
                                        </DataTrigger>
                                    </Border.Triggers>
                                    <Label
                                        Text="{Binding RoleLabel}"
                                        Style="{StaticResource ChipLabel}"
                                        TextColor="{AppThemeBinding Light={StaticResource Neutral}, Dark={StaticResource NeutralDark}}">
                                        <Label.Triggers>
                                            <DataTrigger TargetType="Label" Binding="{Binding RoleLabel}" Value="Administrador">
                                                <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource Pending}, Dark={StaticResource PendingDark}}" />
                                            </DataTrigger>
                                            <DataTrigger TargetType="Label" Binding="{Binding RoleLabel}" Value="Arrendatario">
                                                <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource Success}, Dark={StaticResource SuccessDark}}" />
                                            </DataTrigger>
                                        </Label.Triggers>
                                    </Label>
                                </Border>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </Grid>
    </Grid>

</ContentPage>
