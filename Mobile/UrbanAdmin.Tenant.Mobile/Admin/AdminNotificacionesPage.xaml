<?xml version="1.0" encoding="utf-8" ?>
<!--
  Restyled to the Organic look shared with the redesigned tenant screens (013-tenant-pagos-alertas-redesign):
  the shared header replaces the native title bar, apartment groups get a kicker heading and each pending
  charge is a rounded card. Same data, same grouping.
-->
<ContentPage
    x:Class="UrbanAdmin.Tenant.Mobile.Admin.AdminNotificacionesPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:controls="clr-namespace:UrbanAdmin.Tenant.Mobile.Controls"
    xmlns:models="clr-namespace:UrbanAdmin.Tenant.Mobile.Core.Models;assembly=UrbanAdmin.Tenant.Mobile.Core"
    xmlns:admin="clr-namespace:UrbanAdmin.Tenant.Mobile.Admin"
    Shell.NavBarIsVisible="False"
    Title="Notificaciones">

    <Grid RowDefinitions="Auto,*">
        <controls:TenantHeader
            Grid.Row="0"
            Margin="22,0"
            Kicker="Recordatorios de pago"
            Title="Notificaciones"
            ShowLogout="False" />

        <Grid Grid.Row="1" Padding="22,0,22,0">
            <ActivityIndicator x:Name="BusyIndicator" IsRunning="False" IsVisible="False" VerticalOptions="Center" />

            <Label
                x:Name="EmptyLabel"
                Text="No hay pendientes por cobrar."
                Style="{StaticResource Muted}"
                IsVisible="False"
                HorizontalOptions="Center"
                VerticalOptions="Center" />

            <Label
                x:Name="ErrorLabel"
                Text="No se pudieron cargar las notificaciones."
                FontAttributes="Bold"
                TextColor="{AppThemeBinding Light={StaticResource Pending}, Dark={StaticResource PendingDark}}"
                IsVisible="False"
                HorizontalOptions="Center"
                VerticalOptions="Center" />

            <CollectionView x:Name="ItemsList" IsVisible="False" IsGrouped="True">
                <CollectionView.GroupHeaderTemplate>
                    <DataTemplate x:DataType="admin:ApartmentNotificationGroup">
                        <Label
                            Text="{Binding Header}"
                            Style="{StaticResource Kicker}"
                            Padding="4,14,0,8" />
                    </DataTemplate>
                </CollectionView.GroupHeaderTemplate>
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="models:AdminNotificationRowModel">
                        <Border Style="{StaticResource CardBorder}" Margin="0,0,0,10" Padding="16,12" StrokeShape="RoundRectangle 22">
                            <VerticalStackLayout Spacing="2">
                                <Label Text="{Binding Service}" FontFamily="FigtreeSemibold" FontSize="17" />
                                <Label Text="{Binding DueDate, StringFormat='Vence: {0:d}'}" Style="{StaticResource Muted}" FontSize="13" />
                                <Label
                                    Text="{Binding Status}"
                                    FontAttributes="Bold"
                                    FontSize="13"
                                    TextColor="{AppThemeBinding Light={StaticResource Pending}, Dark={StaticResource PendingDark}}" />
                            </VerticalStackLayout>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </Grid>
    </Grid>

</ContentPage>
