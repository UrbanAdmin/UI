<?xml version="1.0" encoding="utf-8" ?>
<!--
  Restyled to the Organic look shared with the redesigned tenant screens (013-tenant-pagos-alertas-redesign):
  the shared header replaces the native title bar ("Agregar" moved from the toolbar into the header) and
  each apartment is a rounded card. Same data, same interactions.
-->
<ContentPage
    x:Class="UrbanAdmin.Tenant.Mobile.Admin.ApartmentsPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:controls="clr-namespace:UrbanAdmin.Tenant.Mobile.Controls"
    xmlns:models="clr-namespace:UrbanAdmin.Tenant.Mobile.Core.Models;assembly=UrbanAdmin.Tenant.Mobile.Core"
    Shell.NavBarIsVisible="False"
    Title="Apartamentos">

    <Grid RowDefinitions="Auto,*">
        <controls:TenantHeader
            Grid.Row="0"
            Margin="22,0"
            Kicker="Tu conjunto"
            Title="Apartamentos"
            ShowLogout="False"
            ActionText="Agregar"
            ActionClicked="OnAddClicked" />

        <Grid Grid.Row="1" Padding="22,0,22,0">
            <ActivityIndicator x:Name="BusyIndicator" IsRunning="False" IsVisible="False" VerticalOptions="Center" />

            <Label
                x:Name="EmptyLabel"
                Text="No hay apartamentos registrados."
                Style="{StaticResource Muted}"
                IsVisible="False"
                HorizontalOptions="Center"
                VerticalOptions="Center" />

            <Label
                x:Name="ErrorLabel"
                Text="No se pudieron cargar los apartamentos."
                FontAttributes="Bold"
                TextColor="{AppThemeBinding Light={StaticResource Pending}, Dark={StaticResource PendingDark}}"
                IsVisible="False"
                HorizontalOptions="Center"
                VerticalOptions="Center" />

            <CollectionView x:Name="ItemsList" IsVisible="False" SelectionMode="Single" SelectionChanged="OnApartmentSelected">
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="models:ApartmentModel">
                        <Border Style="{StaticResource CardBorder}" Margin="0,0,0,10" Padding="16,14" StrokeShape="RoundRectangle 22">
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                                <VerticalStackLayout Grid.Column="0" Spacing="2">
                                    <Label Text="{Binding Name}" FontFamily="FigtreeSemibold" FontSize="17" />
                                    <Label
                                        Text="{Binding Owner, StringFormat='Propietario: {0}'}"
                                        Style="{StaticResource Muted}"
                                        FontSize="13" />
                                    <Label
                                        Text="{Binding ContractStartDate, StringFormat='Fecha inicio: {0:dd/MM/yyyy}', TargetNullValue='Fecha inicio: Sin definir'}"
                                        Style="{StaticResource Muted}"
                                        FontSize="13" />
                                </VerticalStackLayout>
                                <Border
                                    Grid.Column="1"
                                    VerticalOptions="Center"
                                    Padding="12,4"
                                    Stroke="Transparent"
                                    StrokeShape="RoundRectangle 999">
                                    <Border.Triggers>
                                        <DataTrigger TargetType="Border" Binding="{Binding Status}" Value="Arrendado">
                                            <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource SuccessBg}, Dark={StaticResource SuccessBgDark}}" />
                                        </DataTrigger>
                                        <DataTrigger TargetType="Border" Binding="{Binding Status}" Value="No arrendado">
                                            <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource PendingBg}, Dark={StaticResource PendingBgDark}}" />
                                        </DataTrigger>
                                    </Border.Triggers>
                                    <Label Text="{Binding Status}" Style="{StaticResource ChipLabel}">
                                        <Label.Triggers>
                                            <DataTrigger TargetType="Label" Binding="{Binding Status}" Value="Arrendado">
                                                <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource Success}, Dark={StaticResource SuccessDark}}" />
                                            </DataTrigger>
                                            <DataTrigger TargetType="Label" Binding="{Binding Status}" Value="No arrendado">
                                                <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource Pending}, Dark={StaticResource PendingDark}}" />
                                            </DataTrigger>
                                        </Label.Triggers>
                                    </Label>
                                </Border>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </Grid>
    </Grid>

</ContentPage>
