<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="UrbanAdmin.Tenant.Mobile.Admin.ApartmentsPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:models="clr-namespace:UrbanAdmin.Tenant.Mobile.Core.Models;assembly=UrbanAdmin.Tenant.Mobile.Core"
    Title="Apartamentos">

    <ContentPage.ToolbarItems>
        <ToolbarItem Text="Agregar" Clicked="OnAddClicked" />
    </ContentPage.ToolbarItems>

    <Grid RowDefinitions="*" Padding="16">
        <ActivityIndicator x:Name="BusyIndicator" IsRunning="False" IsVisible="False" VerticalOptions="Center" />

        <Label
            x:Name="EmptyLabel"
            Text="No hay apartamentos registrados."
            IsVisible="False"
            HorizontalOptions="Center"
            VerticalOptions="Center" />

        <Label
            x:Name="ErrorLabel"
            Text="No se pudieron cargar los apartamentos."
            TextColor="Red"
            IsVisible="False"
            HorizontalOptions="Center"
            VerticalOptions="Center" />

        <CollectionView x:Name="ItemsList" IsVisible="False" SelectionMode="Single" SelectionChanged="OnApartmentSelected">
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="models:ApartmentModel">
                    <VerticalStackLayout Padding="0,8" Spacing="2">
                        <Label Text="{Binding Name}" FontAttributes="Bold" />
                        <Label Text="{Binding Owner, StringFormat='Propietario: {0}'}" />
                        <Label Text="{Binding Status}" />
                    </VerticalStackLayout>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </Grid>

</ContentPage>
