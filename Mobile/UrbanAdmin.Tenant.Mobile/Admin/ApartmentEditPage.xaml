<?xml version="1.0" encoding="utf-8" ?>
<!--
  Restyled to the Organic look shared with the redesigned tenant screens (013-tenant-pagos-alertas-redesign):
  the shared header (with a back arrow) replaces the native title bar, fields sit in the theme's pill
  shells and the error text uses the theme color. Same fields, same buttons, same behaviour.
-->
<ContentPage
    x:Class="UrbanAdmin.Tenant.Mobile.Admin.ApartmentEditPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:controls="clr-namespace:UrbanAdmin.Tenant.Mobile.Controls"
    Shell.NavBarIsVisible="False"
    Title="Apartamento">

    <ScrollView>
        <VerticalStackLayout Padding="22,0,22,28" Spacing="14">
            <controls:TenantHeader Kicker="Tu conjunto" Title="Apartamento" ShowLogout="False" ShowBack="True" />

            <Border Style="{StaticResource FieldBorder}" StrokeShape="RoundRectangle 999" Padding="20,2">
                <Entry x:Name="NameEntry" Placeholder="Número" />
            </Border>
            <Border Style="{StaticResource FieldBorder}" StrokeShape="RoundRectangle 999" Padding="20,2">
                <Entry x:Name="OwnerEntry" Placeholder="Propietario" />
            </Border>

            <Border Style="{StaticResource FieldBorder}" StrokeShape="RoundRectangle 999" Padding="20,2">
                <Picker x:Name="StatusPicker" Title="Estado">
                    <Picker.ItemsSource>
                        <x:Array Type="{x:Type x:String}">
                            <x:String>Arrendado</x:String>
                            <x:String>No arrendado</x:String>
                        </x:Array>
                    </Picker.ItemsSource>
                </Picker>
            </Border>

            <Border Style="{StaticResource FieldBorder}" StrokeShape="RoundRectangle 999" Padding="20,2">
                <DatePicker x:Name="ContractStartDatePicker" />
            </Border>

            <Button x:Name="UploadContractButton" Text="Subir contrato" Style="{StaticResource ButtonSecondary}" Clicked="OnUploadContractClicked" />
            <Label x:Name="ContractStatusLabel" Style="{StaticResource Muted}" />
            <Button x:Name="ViewContractButton" Text="Ver contrato" Style="{StaticResource ButtonSecondary}" Clicked="OnViewContractClicked" IsVisible="False" />

            <Label
                x:Name="ErrorLabel"
                FontAttributes="Bold"
                IsVisible="False"
                TextColor="{AppThemeBinding Light={StaticResource Pending}, Dark={StaticResource PendingDark}}" />

            <Button x:Name="SaveButton" Text="Guardar" MinimumHeightRequest="52" Clicked="OnSaveClicked" />
            <Button
                x:Name="DeleteButton"
                Text="Eliminar"
                Style="{StaticResource ButtonSecondary}"
                TextColor="{AppThemeBinding Light={StaticResource Pending}, Dark={StaticResource PendingDark}}"
                Clicked="OnDeleteClicked"
                IsVisible="False" />

            <ActivityIndicator x:Name="BusyIndicator" IsRunning="False" IsVisible="False" />
        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
