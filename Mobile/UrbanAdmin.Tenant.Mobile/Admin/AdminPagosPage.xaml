<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="UrbanAdmin.Tenant.Mobile.Admin.AdminPagosPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:admin="clr-namespace:UrbanAdmin.Tenant.Mobile.Admin"
    Title="Pagos">

    <!-- 011-organic-theme-reskin: Shell.TitleView so the toolbar title picks up
         Caprasimo, since a native platform title can't be styled by a resource
         dictionary alone. -->
    <Shell.TitleView>
        <Label Text="Pagos" Style="{StaticResource Headline}" VerticalOptions="Center" />
    </Shell.TitleView>

    <ContentPage.ToolbarItems>
        <ToolbarItem Text="Editar" Clicked="OnEditClicked" />
    </ContentPage.ToolbarItems>

    <Grid RowDefinitions="Auto,*" Padding="16" RowSpacing="8">
        <HorizontalStackLayout Grid.Row="0" Spacing="8">
            <Picker x:Name="MonthPicker" Title="Mes" SelectedIndexChanged="OnPeriodChanged">
                <Picker.ItemsSource>
                    <x:Array Type="{x:Type x:String}">
                        <x:String>Enero</x:String>
                        <x:String>Febrero</x:String>
                        <x:String>Marzo</x:String>
                        <x:String>Abril</x:String>
                        <x:String>Mayo</x:String>
                        <x:String>Junio</x:String>
                        <x:String>Julio</x:String>
                        <x:String>Agosto</x:String>
                        <x:String>Septiembre</x:String>
                        <x:String>Octubre</x:String>
                        <x:String>Noviembre</x:String>
                        <x:String>Diciembre</x:String>
                    </x:Array>
                </Picker.ItemsSource>
            </Picker>
            <Picker x:Name="YearPicker" Title="Año" SelectedIndexChanged="OnPeriodChanged" />
        </HorizontalStackLayout>

        <Grid Grid.Row="1">
            <ActivityIndicator x:Name="BusyIndicator" IsRunning="False" IsVisible="False" VerticalOptions="Center" />

            <Label
                x:Name="EmptyLabel"
                Text="No hay pagos registrados para este período."
                IsVisible="False"
                HorizontalOptions="Center"
                VerticalOptions="Center" />

            <Label
                x:Name="ErrorLabel"
                Text="No se pudieron cargar los pagos."
                TextColor="Red"
                IsVisible="False"
                HorizontalOptions="Center"
                VerticalOptions="Center" />

            <CollectionView x:Name="ItemsList" IsVisible="False" IsGrouped="True">
                <CollectionView.GroupHeaderTemplate>
                    <DataTemplate x:DataType="admin:ApartmentPagoGroup">
                        <Grid
                            ColumnDefinitions="Auto,*"
                            ColumnSpacing="8"
                            Padding="12,10"
                            BackgroundColor="{AppThemeBinding Light={StaticResource Secondary}, Dark={StaticResource Gray900}}">
                            <Label
                                Grid.Column="0"
                                Text="{Binding ApartmentNumber}"
                                FontAttributes="Bold"
                                FontSize="14"
                                TextColor="{AppThemeBinding Light={StaticResource Tertiary}, Dark={StaticResource PrimaryDark}}" />
                            <Label
                                Grid.Column="1"
                                Text="{Binding OwnerDisplay}"
                                FontSize="12.5"
                                Opacity="0.85"
                                HorizontalTextAlignment="End"
                                TextColor="{AppThemeBinding Light={StaticResource Tertiary}, Dark={StaticResource PrimaryDark}}" />
                        </Grid>
                    </DataTemplate>
                </CollectionView.GroupHeaderTemplate>
                <CollectionView.GroupFooterTemplate>
                    <DataTemplate x:DataType="admin:ApartmentPagoGroup">
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8" Padding="16,6,12,12">
                            <Label
                                Grid.Column="0"
                                Text="{Binding SubtotalLabel}"
                                FontAttributes="Bold"
                                FontSize="12.5"
                                TextColor="{AppThemeBinding Light={StaticResource Gray500}, Dark={StaticResource Gray300}}" />
                            <Label
                                Grid.Column="1"
                                Text="{Binding SubtotalValue}"
                                FontAttributes="Bold"
                                FontSize="12.5" />
                        </Grid>
                    </DataTemplate>
                </CollectionView.GroupFooterTemplate>
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="admin:AdminPagoDisplayRow">
                        <Grid Padding="16,8,10,8" ColumnDefinitions="*,Auto" ColumnSpacing="10">
                            <VerticalStackLayout Grid.Column="0" Spacing="1">
                                <Label Text="{Binding Utility}" FontAttributes="Bold" FontSize="13.5" />
                                <Label
                                    Text="{Binding AmountDisplay}"
                                    FontSize="12"
                                    TextColor="{AppThemeBinding Light={StaticResource Gray500}, Dark={StaticResource Gray300}}" />
                            </VerticalStackLayout>
                            <Border
                                Grid.Column="1"
                                VerticalOptions="Center"
                                Padding="9,3"
                                Stroke="Transparent"
                                StrokeShape="RoundRectangle 999">
                                <Border.Triggers>
                                    <DataTrigger TargetType="Border" Binding="{Binding StatusKind}" Value="paid">
                                        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource SuccessBg}, Dark={StaticResource SuccessBgDark}}" />
                                    </DataTrigger>
                                    <DataTrigger TargetType="Border" Binding="{Binding StatusKind}" Value="pending">
                                        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource PendingBg}, Dark={StaticResource PendingBgDark}}" />
                                    </DataTrigger>
                                    <DataTrigger TargetType="Border" Binding="{Binding StatusKind}" Value="placeholder">
                                        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource PlaceholderBg}, Dark={StaticResource PlaceholderBgDark}}" />
                                    </DataTrigger>
                                </Border.Triggers>
                                <Label Text="{Binding StatusDisplay}" FontSize="11" FontAttributes="Bold">
                                    <Label.Triggers>
                                        <DataTrigger TargetType="Label" Binding="{Binding StatusKind}" Value="paid">
                                            <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource Success}, Dark={StaticResource SuccessDark}}" />
                                        </DataTrigger>
                                        <DataTrigger TargetType="Label" Binding="{Binding StatusKind}" Value="pending">
                                            <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource Pending}, Dark={StaticResource PendingDark}}" />
                                        </DataTrigger>
                                        <DataTrigger TargetType="Label" Binding="{Binding StatusKind}" Value="placeholder">
                                            <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource PlaceholderText}, Dark={StaticResource PlaceholderTextDark}}" />
                                        </DataTrigger>
                                    </Label.Triggers>
                                </Label>
                            </Border>
                        </Grid>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </Grid>
    </Grid>

</ContentPage>
