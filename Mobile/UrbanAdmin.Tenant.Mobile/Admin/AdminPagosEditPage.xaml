<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="UrbanAdmin.Tenant.Mobile.Admin.AdminPagosEditPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:admin="clr-namespace:UrbanAdmin.Tenant.Mobile.Admin"
    xmlns:controls="clr-namespace:UrbanAdmin.Tenant.Mobile.Controls"
    Shell.NavBarIsVisible="False"
    Title="Editar pagos">


    <ScrollView>
        <VerticalStackLayout Padding="22,0,22,28" Spacing="12">
            <controls:TenantHeader Kicker="Pagos del mes" Title="Editar pagos" ShowLogout="False" ShowBack="True" />

            <Border Style="{StaticResource FieldBorder}" StrokeShape="RoundRectangle 999" Padding="20,2">
                <Picker x:Name="ServicioPicker" Title="Servicio" SelectedIndexChanged="OnServicioChanged" />
            </Border>

            <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                <Border Grid.Column="0" Style="{StaticResource FieldBorder}" StrokeShape="RoundRectangle 999" Padding="20,2">
                <Picker x:Name="MonthPicker" Title="Mes" SelectedIndexChanged="OnPeriodChanged">
                    <Picker.ItemsSource>
                        <x:Array Type="{x:Type x:String}">
                            <x:String>Enero</x:String>
                            <x:String>Febrero</x:String>
                            <x:String>Marzo</x:String>
                            <x:String>Abril</x:String>
                            <x:String>Mayo</x:String>
                            <x:String>Junio</x:String>
                            <x:String>Julio</x:String>
                            <x:String>Agosto</x:String>
                            <x:String>Septiembre</x:String>
                            <x:String>Octubre</x:String>
                            <x:String>Noviembre</x:String>
                            <x:String>Diciembre</x:String>
                        </x:Array>
                    </Picker.ItemsSource>
                </Picker>
                </Border>
                <Border Grid.Column="1" Style="{StaticResource FieldBorder}" StrokeShape="RoundRectangle 999" Padding="20,2">
                    <Picker x:Name="YearPicker" Title="Año" SelectedIndexChanged="OnPeriodChanged" />
                </Border>
            </Grid>

            <Grid x:Name="DeadlineRow" ColumnDefinitions="*,Auto" ColumnSpacing="8">
                <Border Grid.Column="0" Style="{StaticResource FieldBorder}" StrokeShape="RoundRectangle 999" Padding="20,2">
                    <DatePicker x:Name="DeadlineDatePicker" />
                </Border>
                <Button x:Name="SaveDeadlineButton" Grid.Column="1" Text="Guardar" Clicked="OnSaveDeadlineClicked" />
            </Grid>
            <Label
                x:Name="ArriendoHintLabel"
                Text="El vencimiento de Arriendo se calcula por apartamento, desde la fecha de inicio del contrato — no se fija aquí."
                Style="{StaticResource Muted}"
                FontSize="13"
                IsVisible="False" />

            <Label
                x:Name="ErrorLabel"
                FontAttributes="Bold"
                TextColor="{AppThemeBinding Light={StaticResource Pending}, Dark={StaticResource PendingDark}}"
                IsVisible="False" />

            <ActivityIndicator x:Name="BusyIndicator" IsRunning="False" IsVisible="False" />

            <Label
                x:Name="EmptyLabel"
                Text="No hay apartamentos para mostrar."
                IsVisible="False"
                HorizontalOptions="Center" />

            <CollectionView x:Name="ItemsList" IsVisible="False">
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="admin:AdminPagoEditRow">
                        <Border Style="{StaticResource CardBorder}" Padding="16,12" Margin="0,4" StrokeShape="RoundRectangle 22">
                            <VerticalStackLayout Spacing="8">
                                <Label Text="{Binding ApartmentLabel}" FontAttributes="Bold" />
                                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="6">
                                    <Label Grid.Column="0" Text="$" VerticalOptions="Center" />
                                    <Entry
                                        Grid.Column="1"
                                        Placeholder="Cantidad a pagar"
                                        Keyboard="Numeric"
                                        Text="{Binding Amount}"
                                        Unfocused="OnAmountUnfocused" />
                                    <Switch
                                        Grid.Column="2"
                                        IsToggled="{Binding Paid}"
                                        Toggled="OnPaidToggled" />
                                </Grid>
                            </VerticalStackLayout>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
