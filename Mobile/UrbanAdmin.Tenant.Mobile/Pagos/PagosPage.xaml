<?xml version="1.0" encoding="utf-8" ?>
<!--
  FR-008: read-only for the tenant. This page deliberately contains no
  Entry/Button/Save control of any kind for the amount, due date, or paid
  status - only Labels and the navigation/logout gestures. The Backend also
  enforces this at the routing level
  (TenantEndpointsTests.MapTenantEndpoints_RegistersOnlyGetFor_TenantPagos).

  013-tenant-pagos-alertas-redesign: built to the approved mockup
  (Mockups/tenant-pagos-timeline/index.html): header with logout, previous/next month arrows, the dark
  "Pendiente este mes" card, the "Conceptos / Solo lectura" status timeline and the closing note.
-->
<ContentPage
    x:Class="UrbanAdmin.Tenant.Mobile.Pagos.PagosPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:controls="clr-namespace:UrbanAdmin.Tenant.Mobile.Controls"
    xmlns:rows="clr-namespace:UrbanAdmin.Tenant.Mobile.Core.ViewModels;assembly=UrbanAdmin.Tenant.Mobile.Core"
    xmlns:shapes="clr-namespace:Microsoft.Maui.Controls.Shapes;assembly=Microsoft.Maui.Controls"
    Shell.NavBarIsVisible="False"
    Title="Pagos">

    <ScrollView>
        <VerticalStackLayout Padding="22,0,22,28" Spacing="0">
            <controls:TenantHeader x:Name="Header" Title="Pagos" />

            <!-- Month navigator: previous / pill / next. Disabled arrows dim and ignore taps. -->
            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10" Margin="0,0,0,14">
                <Border
                    x:Name="PreviousButton"
                    Grid.Column="0"
                    WidthRequest="44"
                    HeightRequest="44"
                    Padding="0"
                    StrokeShape="RoundRectangle 22"
                    SemanticProperties.Description="Mes anterior">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnPreviousTapped" />
                    </Border.GestureRecognizers>
                    <shapes:Path
                        Data="M15 18 9 12 15 6"
                        Aspect="Uniform"
                        WidthRequest="14"
                        HeightRequest="16"
                        HorizontalOptions="Center"
                        VerticalOptions="Center"
                        StrokeThickness="2.2"
                        StrokeLineCap="Round"
                        StrokeLineJoin="Round"
                        Stroke="{AppThemeBinding Light={StaticResource Ink}, Dark={StaticResource Gray100}}" />
                </Border>

                <Border
                    Grid.Column="1"
                    Padding="10,12"
                    Stroke="Transparent"
                    StrokeShape="RoundRectangle 999"
                    BackgroundColor="{AppThemeBinding Light={StaticResource Surface}, Dark={StaticResource SurfaceDark}}">
                    <Label
                        x:Name="MonthLabel"
                        FontAttributes="Bold"
                        FontSize="15"
                        HorizontalTextAlignment="Center"
                        SemanticProperties.HeadingLevel="Level2" />
                </Border>

                <Border
                    x:Name="NextButton"
                    Grid.Column="2"
                    WidthRequest="44"
                    HeightRequest="44"
                    Padding="0"
                    StrokeShape="RoundRectangle 22"
                    SemanticProperties.Description="Mes siguiente">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnNextTapped" />
                    </Border.GestureRecognizers>
                    <shapes:Path
                        Data="M9 18 15 12 9 6"
                        Aspect="Uniform"
                        WidthRequest="14"
                        HeightRequest="16"
                        HorizontalOptions="Center"
                        VerticalOptions="Center"
                        StrokeThickness="2.2"
                        StrokeLineCap="Round"
                        StrokeLineJoin="Round"
                        Stroke="{AppThemeBinding Light={StaticResource Ink}, Dark={StaticResource Gray100}}" />
                </Border>
            </Grid>

            <ActivityIndicator x:Name="BusyIndicator" IsRunning="False" IsVisible="False" Margin="0,60,0,0" />

            <VerticalStackLayout x:Name="ErrorPanel" IsVisible="False" Spacing="12" Margin="0,4,0,0">
                <Border
                    Padding="18,16"
                    Stroke="Transparent"
                    StrokeShape="RoundRectangle 22"
                    BackgroundColor="{AppThemeBinding Light={StaticResource PendingBg}, Dark={StaticResource PendingBgDark}}">
                    <Label
                        x:Name="ErrorLabel"
                        FontAttributes="Bold"
                        TextColor="{AppThemeBinding Light={StaticResource Pending}, Dark={StaticResource PendingDark}}" />
                </Border>
                <Button Text="Reintentar" HorizontalOptions="Center" Clicked="OnRetryClicked" />
            </VerticalStackLayout>

            <VerticalStackLayout x:Name="ContentPanel" IsVisible="False" Spacing="0">
                <!-- Dark summary card: the unpaid total and how many concepts are pending. -->
                <Border Style="{StaticResource HeroBorder}" Padding="24,22,24,20">
                    <Grid>
                        <Ellipse
                            WidthRequest="190"
                            HeightRequest="190"
                            HorizontalOptions="End"
                            VerticalOptions="End"
                            TranslationX="70"
                            TranslationY="100"
                            Fill="{StaticResource White}"
                            Opacity="0.07" />
                        <VerticalStackLayout Spacing="0">
                            <Label
                                Text="Pendiente este mes"
                                Style="{StaticResource Kicker}"
                                TextColor="{StaticResource Accent2}" />
                            <Label
                                x:Name="TotalLabel"
                                FontFamily="CaprasimoRegular"
                                FontSize="42"
                                TextColor="{StaticResource SuccessBg}"
                                Margin="0,10,0,0" />
                            <Label
                                x:Name="HintLabel"
                                FontSize="14"
                                TextColor="{StaticResource SuccessBg}"
                                Opacity="0.88"
                                Margin="0,4,0,0" />
                        </VerticalStackLayout>
                    </Grid>
                </Border>

                <Grid ColumnDefinitions="*,Auto" Margin="2,24,2,12">
                    <Label Grid.Column="0" Text="Conceptos" Style="{StaticResource SubHeadline}" FontSize="22" VerticalOptions="Center" />
                    <Label Grid.Column="1" Text="Solo lectura" Style="{StaticResource Muted}" VerticalOptions="Center" />
                </Grid>

                <Border
                    x:Name="EmptyPanel"
                    IsVisible="False"
                    Padding="18,20"
                    Stroke="{AppThemeBinding Light={StaticResource Gray300}, Dark={StaticResource Gray600}}"
                    StrokeDashArray="4,4"
                    StrokeShape="RoundRectangle 22">
                    <Label
                        Text="Este mes no tiene conceptos registrados."
                        Style="{StaticResource Muted}"
                        HorizontalTextAlignment="Center" />
                </Border>

                <!-- Status timeline: a dot on a vertical line, the date line, the name + amount, the chip. -->
                <VerticalStackLayout x:Name="TimelineList" Spacing="0">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="rows:PagoTimelineRow">
                            <Grid ColumnDefinitions="26,*">
                                <BoxView
                                    Grid.Column="0"
                                    WidthRequest="2"
                                    HorizontalOptions="Center"
                                    VerticalOptions="Fill"
                                    Color="{AppThemeBinding Light={StaticResource Divider}, Dark={StaticResource DividerDark}}" />
                                <controls:StatusDot
                                    Grid.Column="0"
                                    Kind="{Binding StatusKind}"
                                    Size="16"
                                    HorizontalOptions="Center"
                                    Margin="0,2,0,0" />

                                <VerticalStackLayout Grid.Column="1" Spacing="3" Padding="0,0,0,20">
                                    <Label Text="{Binding DateLine}" Style="{StaticResource Kicker}" />
                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                                        <Label
                                            Grid.Column="0"
                                            Text="{Binding Utility}"
                                            FontFamily="FigtreeSemibold"
                                            FontSize="18" />
                                        <Label
                                            Grid.Column="1"
                                            Text="{Binding AmountDisplay}"
                                            FontAttributes="Bold"
                                            FontSize="17"
                                            HorizontalTextAlignment="End">
                                            <Label.Triggers>
                                                <DataTrigger TargetType="Label" Binding="{Binding AmountMissing}" Value="True">
                                                    <Setter Property="FontAttributes" Value="Italic" />
                                                    <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource Gray500}, Dark={StaticResource Gray300}}" />
                                                </DataTrigger>
                                            </Label.Triggers>
                                        </Label>
                                    </Grid>
                                    <controls:StatusChip Kind="{Binding StatusKind}" Text="{Binding StatusLabel}" Margin="0,4,0,0" />
                                </VerticalStackLayout>
                            </Grid>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </VerticalStackLayout>

                <!-- Closing note: this app shows status, it never takes money. -->
                <Border
                    Margin="0,8,0,0"
                    Padding="18,16"
                    Stroke="{AppThemeBinding Light={StaticResource Gray300}, Dark={StaticResource Gray600}}"
                    StrokeDashArray="4,4"
                    StrokeShape="RoundRectangle 22">
                    <Label
                        Text="Los pagos se registran en la administración. Esta app muestra el estado, no recibe dinero."
                        Style="{StaticResource Muted}"
                        FontSize="14" />
                </Border>
            </VerticalStackLayout>
        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
