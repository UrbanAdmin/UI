<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="UrbanAdmin.Tenant.Mobile.Auth.LoginPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Title="Ingresar">

    <!-- 011-organic-theme-reskin: native Shell/toolbar titles don't pick up the
         Caprasimo Headline style from a resource-dictionary swap alone (they're
         platform toolbar text, not a MAUI Label) - Shell.TitleView replaces the
         native title with a themed Label instead, cross-platform, no native code. -->
    <Shell.TitleView>
        <Label Text="Ingresar" Style="{StaticResource Headline}" VerticalOptions="Center" />
    </Shell.TitleView>

    <VerticalStackLayout Padding="24" Spacing="16" VerticalOptions="Center">
        <Label Text="UrbanAdmin" Style="{StaticResource Headline}" HorizontalOptions="Center" HorizontalTextAlignment="Center" />

        <Entry x:Name="UsernameEntry" Placeholder="Usuario" />
        <Entry x:Name="PasswordEntry" Placeholder="Contraseña" IsPassword="True" />

        <Label
            x:Name="ErrorLabel"
            TextColor="Red"
            IsVisible="False" />

        <Button x:Name="LoginButton" Text="Ingresar" Clicked="OnLoginClicked" />

        <ActivityIndicator x:Name="BusyIndicator" IsRunning="False" IsVisible="False" />
    </VerticalStackLayout>

</ContentPage>
